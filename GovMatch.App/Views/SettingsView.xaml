<UserControl x:Class="GovMatch.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="SAM.gov API Key:" FontWeight="Bold" Margin="0,10,0,5"/>
            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Visit https://sam.gov/data-services for API key" FontStyle="Italic" FontSize="10" Foreground="Gray"/>

            <TextBlock Text="Environment:" FontWeight="Bold" Margin="0,10,0,5"/>
            <ComboBox SelectedValue="{Binding Environment}">
                <ComboBoxItem Content="Production" IsSelected="True"/>
                <ComboBoxItem Content="Alpha"/>
            </ComboBox>

            <TextBlock Text="Daily Rate Limit Tier:" FontWeight="Bold" Margin="0,10,0,5"/>
            <ComboBox SelectedValue="{Binding DailyRateLimitTier}">
                <ComboBoxItem Content="10" Tag="10"/>
                <ComboBoxItem Content="1,000" Tag="1000"/>
                <ComboBoxItem Content="10,000" Tag="10000"/>
            </ComboBox>

            <CheckBox Content="Enable Prefetch for Top Matches" IsChecked="{Binding EnablePrefetch}" Margin="0,15,0,5"/>

            <TextBlock Text="Prefetch Threshold (score):" FontWeight="Bold" Margin="0,10,0,5"/>
            <StackPanel Orientation="Horizontal">
                <Slider Width="200" Minimum="0" Maximum="100" Value="{Binding PrefetchThreshold}"/>
                <TextBlock Text="{Binding PrefetchThreshold}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Content="Save Settings" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,20,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
